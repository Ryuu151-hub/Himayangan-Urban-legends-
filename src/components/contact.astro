<section id="contact" class="w-full py-16 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-8">
      Contact
    </h3>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <!-- Facebook -->
      <a
        href="https://www.facebook.com/KnownASxyroo"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center gap-3 p-6 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:border-[var(--sec)] transition-colors group"
      >
        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#1877F2]/20 text-[#1877F2] group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </div>
        <div class="text-center">
          <p class="text-[var(--white)] font-medium">Facebook</p>
          <p class="text-sm text-[var(--white-icon)] mt-1">Janus John C. Asuncion</p>
        </div>
      </a>

      <!-- Gmail -->
      <a
        href="mailto:idleryuu318@gmail.com"
        class="flex flex-col items-center gap-3 p-6 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:border-[var(--sec)] transition-colors group"
      >
        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-[#EA4335]/20 text-[#EA4335] group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
          </svg>
        </div>
        <div class="text-center">
          <p class="text-[var(--white)] font-medium">Gmail</p>
          <p class="text-sm text-[var(--white-icon)] mt-1">idleryuu318@gmail.com</p>
        </div>
      </a>

      <!-- TikTok -->
      <a
        href="https://www.tiktok.com/@ryu60fps"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center gap-3 p-6 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:border-[var(--sec)] transition-colors group"
      >
        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-white/10 text-white group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
          </svg>
        </div>
        <div class="text-center">
          <p class="text-[var(--white)] font-medium">TikTok</p>
          <p class="text-sm text-[var(--white-icon)] mt-1">@ryu60fps</p>
        </div>
      </a>
    </div>
  </div>
</section>
