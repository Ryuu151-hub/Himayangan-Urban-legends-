---
const currentYear = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="w-full py-12 border-t border-[#ffffff10] mt-8">
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col lg:flex-row justify-between items-center gap-6">
      <div class="text-center lg:text-left">
        <p class="text-[var(--white)] text-lg font-medium">Video Showcase</p>
        <p class="text-sm text-[var(--white-icon)] mt-1">
          Powered by GitHub + Vercel
        </p>
      </div>

      <div class="flex items-center gap-6 text-sm text-[var(--white-icon)]">
        <span>Built with Astro</span>
        <span>•</span>
        <span>Styled with Tailwind</span>
        <span>•</span>
        <span>Deployed on Vercel</span>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-[#ffffff10]">
      <p class="text-center text-sm text-[var(--white-icon)]">
        © {currentYear} · Design based on Dark Minimal by
        <a
          href="https://github.com/Gothsec"
          target="_blank"
          class="hover:text-[var(--white)] transition"
          >Andres Hernandez</a
        >
        · Distributed by
        <a
          href="https://themewagon.com"
          target="_blank"
          class="hover:text-[var(--white)] transition"
          >ThemeWagon</a
        >
      </p>
    </div>
  </div>
</footer>
